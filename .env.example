# Agent Extract — local / deploy config
# Do NOT commit real secrets.

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Fetch limits
FETCH_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=2097152
USER_AGENT=ToolFarm-AgentExtract/0.1 (+https://example.com/toolfarm)

# Optional shared secret for bearer auth (leave empty to disable)
API_KEY=

# Monetization notes (not used by the server itself):
# MCPize: x402 USDC on Base, suggest $0.01–0.02 per url_to_markdown call (publisher keeps ~80%)
# Ozma: Stripe Connect only; x402 disabled in prod; OpenAPI at /openapi.json
